# Run python3 prepare.py to generate unique local values in .env.
# Do not use these placeholders for a real deployment.
DB_PASSWORD=replace_with_a_random_database_password
JWT_SECRET_KEY=replace_with_a_random_signing_key

# Optional overrides for additional deployments on the same machine:
# COMPOSE_PROJECT_NAME=rag-test
# WEB_PORT=8092
# API_PORT=8093

# Vision model used by local image and video extraction:
# VISION_MODEL=qwen3-vl:4b-instruct
